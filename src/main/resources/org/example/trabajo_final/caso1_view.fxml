<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.trabajo_final.EventoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Sistema Concurrente de Reserva de Entradas" />

    <GridPane hgap="10.0" vgap="10.0">
        <children>
            <Label text="Entradas Disponibles:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="lblDisponibles" style="-fx-font-weight: bold;" text="20" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Reservas Confirmadas:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="lblConfirmadas" style="-fx-font-weight: bold; -fx-text-fill: green;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Solicitudes Rechazadas:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="lblRechazadas" style="-fx-font-weight: bold; -fx-text-fill: red;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </children>
    </GridPane>

    <Label fx:id="lblEstado" style="-fx-font-style: italic;" text="Estado: Listo para iniciar." />

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Button fx:id="btnIniciar" onAction="#handleIniciar" prefWidth="120.0" text="Iniciar Simulación" />
            <Button fx:id="btnReiniciar" onAction="#handleReiniciar" prefWidth="120.0" text="Reiniciar" />
        </children>
    </HBox>
</VBox>
