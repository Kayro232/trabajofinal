<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.trabajo_final.HelloController"
      alignment="TOP_CENTER"
      spacing="20"
      prefWidth="720"
      prefHeight="560"
      style="-fx-background-color: #f1f5f9;">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Reserva de entradas"
           style="-fx-font-size: 28px; -fx-font-weight: bold;
                  -fx-text-fill: #0f172a;"/>

    <Label text="20 entradas · 3 agentes · 10 solicitudes por agente"
           style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>

    <HBox alignment="CENTER" spacing="15">

        <VBox alignment="CENTER" spacing="8"
              HBox.hgrow="ALWAYS" maxWidth="Infinity"
              style="-fx-background-color: white;
                     -fx-background-radius: 12; -fx-padding: 20;">

            <Label text="Disponibles"
                   style="-fx-font-size: 15px;"/>

            <Label fx:id="disponiblesLabel" text="20"
                   style="-fx-font-size: 36px; -fx-font-weight: bold;
                          -fx-text-fill: #2563eb;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8"
              HBox.hgrow="ALWAYS" maxWidth="Infinity"
              style="-fx-background-color: white;
                     -fx-background-radius: 12; -fx-padding: 20;">

            <Label text="Confirmadas"
                   style="-fx-font-size: 15px;"/>

            <Label fx:id="confirmadasLabel" text="0"
                   style="-fx-font-size: 36px; -fx-font-weight: bold;
                          -fx-text-fill: #15803d;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="8"
              HBox.hgrow="ALWAYS" maxWidth="Infinity"
              style="-fx-background-color: white;
                     -fx-background-radius: 12; -fx-padding: 20;">

            <Label text="Rechazadas"
                   style="-fx-font-size: 15px;"/>

            <Label fx:id="rechazadasLabel" text="0"
                   style="-fx-font-size: 36px; -fx-font-weight: bold;
                          -fx-text-fill: #b91c1c;"/>
        </VBox>

    </HBox>

    <Button fx:id="iniciarButton"
            text="Iniciar simulación"
            style="-fx-background-color: #2563eb;
                   -fx-text-fill: white;
                   -fx-font-size: 15px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8;
                   -fx-padding: 12 25;
                   -fx-cursor: hand;"/>

    <Label fx:id="estadoLabel"
           text="Listo para iniciar"
           style="-fx-font-size: 14px; -fx-text-fill: #475569;"/>

    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="Actividad de los agentes"
               style="-fx-font-size: 16px; -fx-font-weight: bold;
                      -fx-text-fill: #0f172a;"/>

        <TextArea fx:id="registroArea"
                  editable="false"
                  wrapText="true"
                  promptText="Aquí aparecerán las solicitudes de los agentes."
                  VBox.vgrow="ALWAYS"/>
    </VBox>

</VBox>