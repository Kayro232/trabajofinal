<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.trabajo_final.CasoEs2.PedidosController"
      prefWidth="660.0"
      prefHeight="540.0"
      spacing="24.0"
      style="-fx-background-color: #f1f5f9;
             -fx-font-family: 'Segoe UI';">

    <padding>
        <Insets top="32.0" right="32.0"
                bottom="32.0" left="32.0"/>
    </padding>

    <children>

        <VBox spacing="8.0">
            <children>
                <Label text="GESTIÓN DE PEDIDOS"
                       style="-fx-text-fill: #2563eb;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

                <Label text="Procesamiento de pedidos"
                       wrapText="true"
                       style="-fx-text-fill: #0f172a;
                              -fx-font-size: 27px;
                              -fx-font-weight: bold;"/>

                <Label text="Simulación de 30 pedidos con cancelación cooperativa"
                       wrapText="true"
                       style="-fx-text-fill: #64748b;
                              -fx-font-size: 14px;"/>
            </children>
        </VBox>

        <VBox spacing="24.0"
              style="-fx-background-color: white;
                     -fx-background-radius: 16;
                     -fx-border-color: #e2e8f0;
                     -fx-border-radius: 16;">

            <padding>
                <Insets top="28.0" right="28.0"
                        bottom="28.0" left="28.0"/>
            </padding>

            <children>

                <VBox spacing="10.0">
                    <children>
                        <Label text="ESTADO ACTUAL"
                               style="-fx-text-fill: #64748b;
                                      -fx-font-size: 11px;
                                      -fx-font-weight: bold;"/>

                        <Label fx:id="lblEstado"
                               text="Listo"
                               style="-fx-text-fill: #475569;
                                      -fx-background-color: #e2e8f0;
                                      -fx-background-radius: 20;
                                      -fx-padding: 7 14;
                                      -fx-font-size: 13px;
                                      -fx-font-weight: bold;"/>
                    </children>
                </VBox>

                <Separator/>

                <VBox spacing="14.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Progreso general"
                                       style="-fx-text-fill: #334155;
                                              -fx-font-size: 14px;
                                              -fx-font-weight: bold;"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="lblPorcentaje"
                                       text="0 %"
                                       style="-fx-text-fill: #2563eb;
                                              -fx-font-size: 18px;
                                              -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <ProgressBar fx:id="barraProgreso"
                                     progress="0.0"
                                     prefHeight="18.0"
                                     maxWidth="Infinity"
                                     style="-fx-accent: #2563eb;"/>

                        <Label fx:id="lblContador"
                               text="0 / 30 pedidos"
                               style="-fx-text-fill: #334155;
                                      -fx-font-size: 15px;
                                      -fx-font-weight: bold;"/>

                        <Label fx:id="lblMensaje"
                               text="Presiona Iniciar para procesar los pedidos."
                               wrapText="true"
                               minHeight="42.0"
                               maxWidth="Infinity"
                               style="-fx-text-fill: #64748b;
                                      -fx-font-size: 13px;"/>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button fx:id="btnIniciar"
                                text="Iniciar"
                                onAction="#iniciar"
                                prefWidth="135.0"
                                prefHeight="44.0"
                                mnemonicParsing="false"
                                style="-fx-background-color: #2563eb;
                                       -fx-text-fill: white;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;
                                       -fx-cursor: hand;"/>

                        <Button fx:id="btnCancelar"
                                text="Cancelar"
                                onAction="#cancelar"
                                prefWidth="135.0"
                                prefHeight="44.0"
                                disable="true"
                                mnemonicParsing="false"
                                style="-fx-background-color: #fee2e2;
                                       -fx-text-fill: #b91c1c;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;
                                       -fx-cursor: hand;"/>
                    </children>
                </HBox>

            </children>
        </VBox>

        <Label text="30 pedidos · 200 ms por pedido · Ejecución en segundo plano"
               wrapText="true"
               style="-fx-text-fill: #64748b;
                      -fx-font-size: 12px;"/>

    </children>
</VBox>