<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            prefWidth="820.0"
            prefHeight="800.0"
            style="-fx-background: #f1f5f9;
                   -fx-background-color: #f1f5f9;">

    <content>
        <VBox spacing="22.0"
              style="-fx-background-color: #f1f5f9;
                     -fx-font-family: 'Segoe UI';">

            <padding>
                <Insets top="30.0" right="30.0"
                        bottom="30.0" left="30.0"/>
            </padding>

            <children>

                <!-- Encabezado -->
                <VBox spacing="8.0">
                    <children>
                        <Label text="SIMULACIÓN DE VENTAS"
                               style="-fx-text-fill: #2563eb;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>

                        <Label text="Caja de ventas concurrente"
                               wrapText="true"
                               style="-fx-text-fill: #0f172a;
                                      -fx-font-size: 28px;
                                      -fx-font-weight: bold;"/>

                        <Label text="Tres vendedores · Cinco ventas por vendedor · C$100 por venta"
                               wrapText="true"
                               style="-fx-text-fill: #64748b;
                                      -fx-font-size: 14px;"/>
                    </children>
                </VBox>

                <!-- Estado y controles -->
                <VBox spacing="16.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 14;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 14;">

                    <padding>
                        <Insets top="22.0" right="22.0"
                                bottom="22.0" left="22.0"/>
                    </padding>

                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Estado de la simulación"
                                       style="-fx-text-fill: #334155;
                                              -fx-font-weight: bold;
                                              -fx-font-size: 14px;"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="lblEstado"
                                       text="Listo"
                                       style="-fx-text-fill: #475569;
                                              -fx-background-color: #e2e8f0;
                                              -fx-background-radius: 20;
                                              -fx-padding: 7 14;
                                              -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <Label fx:id="lblMensaje"
                               text="Presiona Iniciar para comenzar una nueva simulación."
                               wrapText="true"
                               style="-fx-text-fill: #64748b;
                                      -fx-font-size: 13px;"/>

                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="btnIniciar"
                                        text="Iniciar simulación"
                                        prefHeight="42.0"
                                        prefWidth="180.0"
                                        mnemonicParsing="false"
                                        style="-fx-background-color: #2563eb;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 8;
                                               -fx-font-size: 14px;
                                               -fx-font-weight: bold;
                                               -fx-cursor: hand;"/>

                                <Button fx:id="btnCancelar"
                                        text="Cancelar"
                                        prefHeight="42.0"
                                        prefWidth="130.0"
                                        disable="true"
                                        mnemonicParsing="false"
                                        style="-fx-background-color: #fee2e2;
                                               -fx-text-fill: #b91c1c;
                                               -fx-background-radius: 8;
                                               -fx-font-size: 14px;
                                               -fx-font-weight: bold;
                                               -fx-cursor: hand;"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Totales -->
                <GridPane hgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0"
                                           hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50.0"
                                           hgrow="ALWAYS"/>
                    </columnConstraints>

                    <children>
                        <VBox spacing="8.0"
                              GridPane.columnIndex="0"
                              style="-fx-background-color: #dbeafe;
                                     -fx-background-radius: 14;">
                            <padding>
                                <Insets top="20.0" right="20.0"
                                        bottom="20.0" left="20.0"/>
                            </padding>
                            <children>
                                <Label text="VENTAS CONFIRMADAS"
                                       style="-fx-text-fill: #1d4ed8;
                                              -fx-font-size: 11px;
                                              -fx-font-weight: bold;"/>

                                <Label fx:id="lblTotalVentas"
                                       text="0 / 15"
                                       style="-fx-text-fill: #1e3a8a;
                                              -fx-font-size: 30px;
                                              -fx-font-weight: bold;"/>
                            </children>
                        </VBox>

                        <VBox spacing="8.0"
                              GridPane.columnIndex="1"
                              style="-fx-background-color: #dcfce7;
                                     -fx-background-radius: 14;">
                            <padding>
                                <Insets top="20.0" right="20.0"
                                        bottom="20.0" left="20.0"/>
                            </padding>
                            <children>
                                <Label text="RECAUDACIÓN TOTAL"
                                       style="-fx-text-fill: #15803d;
                                              -fx-font-size: 11px;
                                              -fx-font-weight: bold;"/>

                                <Label fx:id="lblRecaudacion"
                                       text="C$0.00"
                                       style="-fx-text-fill: #14532d;
                                              -fx-font-size: 30px;
                                              -fx-font-weight: bold;"/>
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <!-- Avance por vendedor -->
                <VBox spacing="18.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 14;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 14;">

                    <padding>
                        <Insets top="22.0" right="22.0"
                                bottom="22.0" left="22.0"/>
                    </padding>

                    <children>
                        <Label text="Avance por vendedor"
                               style="-fx-text-fill: #0f172a;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <!-- Vendedor 1 -->
                        <VBox spacing="9.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Vendedor 1"
                                               style="-fx-text-fill: #334155;
                                                      -fx-font-weight: bold;"/>
                                        <Label fx:id="lblEstadoVendedor1"
                                               text="En espera"
                                               style="-fx-text-fill: #64748b;
                                                      -fx-font-size: 12px;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblVentasVendedor1"
                                               text="0 / 5 ventas"
                                               style="-fx-text-fill: #2563eb;
                                                      -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>

                                <ProgressBar fx:id="progresoVendedor1"
                                             progress="0.0"
                                             maxWidth="Infinity"
                                             prefHeight="14.0"
                                             style="-fx-accent: #2563eb;"/>
                            </children>
                        </VBox>

                        <Separator/>

                        <!-- Vendedor 2 -->
                        <VBox spacing="9.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Vendedor 2"
                                               style="-fx-text-fill: #334155;
                                                      -fx-font-weight: bold;"/>
                                        <Label fx:id="lblEstadoVendedor2"
                                               text="En espera"
                                               style="-fx-text-fill: #64748b;
                                                      -fx-font-size: 12px;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblVentasVendedor2"
                                               text="0 / 5 ventas"
                                               style="-fx-text-fill: #7c3aed;
                                                      -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>

                                <ProgressBar fx:id="progresoVendedor2"
                                             progress="0.0"
                                             maxWidth="Infinity"
                                             prefHeight="14.0"
                                             style="-fx-accent: #7c3aed;"/>
                            </children>
                        </VBox>

                        <Separator/>

                        <!-- Vendedor 3 -->
                        <VBox spacing="9.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Vendedor 3"
                                               style="-fx-text-fill: #334155;
                                                      -fx-font-weight: bold;"/>
                                        <Label fx:id="lblEstadoVendedor3"
                                               text="En espera"
                                               style="-fx-text-fill: #64748b;
                                                      -fx-font-size: 12px;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="lblVentasVendedor3"
                                               text="0 / 5 ventas"
                                               style="-fx-text-fill: #0d9488;
                                                      -fx-font-weight: bold;"/>
                                    </children>
                                </HBox>

                                <ProgressBar fx:id="progresoVendedor3"
                                             progress="0.0"
                                             maxWidth="Infinity"
                                             prefHeight="14.0"
                                             style="-fx-accent: #0d9488;"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Registro de ventas -->
                <VBox spacing="12.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 14;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 14;">

                    <padding>
                        <Insets top="22.0" right="22.0"
                                bottom="22.0" left="22.0"/>
                    </padding>

                    <children>
                        <Label text="Registro de ventas confirmadas"
                               style="-fx-text-fill: #0f172a;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>

                        <ListView fx:id="listaVentas"
                                  prefHeight="170.0"
                                  style="-fx-background-color: #f8fafc;
                                         -fx-border-color: #e2e8f0;
                                         -fx-border-radius: 6;
                                         -fx-background-radius: 6;">
                            <placeholder>
                                <Label text="Las ventas confirmadas aparecerán aquí."
                                       wrapText="true"
                                       style="-fx-text-fill: #94a3b8;"/>
                            </placeholder>
                        </ListView>
                    </children>
                </VBox>

                <Label text="Meta de la simulación: 15 ventas confirmadas y C$1,500.00 de recaudación."
                       wrapText="true"
                       style="-fx-text-fill: #64748b;
                              -fx-font-size: 12px;"/>

            </children>
        </VBox>
    </content>
</ScrollPane>